{
  "rules": {
    "settings": {
      ".read": true,
      ".write": true,
      "open": { ".validate": "newData.isBoolean()" },
      "$other": { ".validate": false }
    },
    "counter": {
      ".read": true,
      ".write": true,
      ".validate": "newData.isNumber() && newData.val() >= 0"
    },
    "requests": {
      ".read": true,
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['name', 'ticket', 'status', 'createdAt'])",
        "name":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
        "ticket":    { ".validate": "newData.isNumber()" },
        "status":    { ".validate": "newData.val() === 'waiting' || newData.val() === 'coming' || newData.val() === 'done' || newData.val() === 'cancelled'" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other":    { ".validate": false }
      }
    }
  }
}
